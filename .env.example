# Variables de entorno para PROYECTO-TELITO
# Copia este archivo a .env y configura los valores reales

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=telito_dev
DB_USERNAME=root
DB_PASSWORD=root
# OAuth2 Google Configuration
# Ve a: https://console.cloud.google.com/ > APIs & Services > Credentials
# Crea OAuth 2.0 Client IDs y configura estos valores:
GOOGLE_OAUTH2_CLIENT_ID=tu-google-client-id-aqui.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=tu-google-client-secret-aqui

# Configuración del servidor
SERVER_PORT=8080

# Configuración de desarrollo
SPRING_PROFILES_ACTIVE=dev

# Configuración de logging (opcional)
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_TELITODEV=DEBUG